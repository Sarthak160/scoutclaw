{
  "name": "scoutclaw",
  "version": "0.1.0",
  "description": "Two-sided OpenClaw dashboard for hiring and job-search outreach campaigns with filters, payments, Postgres, and Redis.",
  "type": "module",
  "bin": {
    "scoutclaw": "./dist/cli.js"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "cli": "tsx src/cli.ts",
    "build:cli": "tsc -p tsconfig.build.json",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/*.test.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "commander": "^14.0.1",
    "dotenv": "^17.2.3",
    "graphql": "^16.13.2",
    "ioredis": "^5.10.1",
    "next": "^15.5.15",
    "pdf-parse": "^2.4.5",
    "prisma": "^6.16.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "stripe": "^22.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}
