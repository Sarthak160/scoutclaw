{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "sourceMap": true,
    "incremental": false,
    "jsx": "react-jsx",
    "lib": ["ES2022"],
    "types": ["node"],
    "plugins": []
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", ".next", "app", "test"]
}
